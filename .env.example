# Server only. Never copy these values into config/app.js or frontend code.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Create a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Local API writes; production defaults to the HTTPS host of the request.
WORKS_ORIGIN=http://localhost:4173
# Production: the HTTPS origin that serves your own /data/amba files.
# Local development can leave it blank to verify against local dataset files.
WORKS_DATA_ORIGIN=
# Exact municipal hosts after review; no wildcard, no URL scheme.
# Empty means all QR destinations remain pending and no remote page is fetched.
WORKS_PERMIT_HOSTS=
